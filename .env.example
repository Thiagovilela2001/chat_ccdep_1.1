# Provedor LLM ativo
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=deepseek-flash
RAG_EXTRACT_MODEL=deepseek-flash
RAG_INTERP_MODEL=deepseek-flash

# Esforco de raciocinio por papel (none | low | medium | high)
RAG_LLM_REASONING_EFFORT=none
RAG_INTERP_REASONING_EFFORT=none
RAG_EXTRACT_REASONING_EFFORT=none

# Reranking e limites de contexto
RAG_LLM_RERANK=1
RAG_CONTEXT_TOP_K=10
RAG_TEXT_TOP_N=12
RAG_STRUCTURED_TOP_N=8
RAG_INGEST_LLM_ENRICHMENT=0

# Validação numérica e tentativas de recuperação
# RAG_NUMERIC_VALIDATION: valida números e gera cards de citação (1=ativo, 0=desativado)
RAG_NUMERIC_VALIDATION=1
# RAG_ANSWER_RETRIES: novas tentativas para recusa com fontes ou cobertura incompleta (1=ativo, 0=desativado)
RAG_ANSWER_RETRIES=1

# Configurações de API e Judge
RAGAS_JUDGE_PROVIDER=deepseek
RAGAS_JUDGE_MODEL=deepseek-chat
RAGAS_JUDGE_BASE_URL=https://api.deepseek.com
RAGAS_JUDGE_API_KEY=your-judge-api-key

RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_API_KEY=your-api-key
RAG_POPUP_MODEL=deepseek-chat
RAG_POPUP_EXPLANATIONS=0
RAG_QUERY_FUSION_QUERIES=1

